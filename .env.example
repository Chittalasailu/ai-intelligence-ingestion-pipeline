# ==== LLM Providers (multi-tier fallback: Gemini -> Groq -> DeepSeek) ====
# Leave any of these blank to disable that tier; the orchestrator will skip
# providers with no key configured and fall through to the next one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ==== GitHub (used for star counts on research papers + higher API rate limit) ====
# Unauthenticated GitHub API is capped at 60 requests/hour, shared per IP.
# A personal access token (no scopes needed for public data) raises this to 5000/hour.
GITHUB_TOKEN=

# ==== Storage ====
# Demo default: local SQLite file, zero setup required.
# Production: point at a real Postgres instance, e.g.
#   postgresql+asyncpg://user:password@localhost:5432/intelligence_graph
DATABASE_URL=sqlite+aiosqlite:///./data/pipeline.db

# ==== Google Sheets export (optional) ====
# Path to a Google service-account JSON key with Sheets + Drive API access.
# See docs/GOOGLE_SHEETS_SETUP.md for the one-time setup steps.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
GOOGLE_SHEET_ID=

# ==== Crawler tuning ====
MAX_CONCURRENCY=25
PER_HOST_CONCURRENCY=5
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=4

# ==== Freshness window (hours) for news/jobs ====
FRESHNESS_WINDOW_HOURS=24

LOG_LEVEL=INFO
